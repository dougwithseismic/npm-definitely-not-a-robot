{
    "name": "definitely-not-a-robot",
    "version": "1.0.0",
    "description": "Human-like mouse, typing and scrolling for Playwright. Curved cursor paths, real keystroke rhythm, a visible cursor for demo videos, and seeds for reproducible runs.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
        "smoke": "node scripts/smoke.mjs",
        "prepublishOnly": "pnpm check"
    },
    "keywords": [
        "playwright",
        "human",
        "humanize",
        "mouse",
        "cursor",
        "mouse-movement",
        "typing",
        "bezier",
        "automation",
        "e2e",
        "testing",
        "demo-video",
        "puppeteer"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dougwithseismic/npm-definitely-not-a-robot.git"
    },
    "homepage": "https://github.com/dougwithseismic/npm-definitely-not-a-robot#readme",
    "bugs": {
        "url": "https://github.com/dougwithseismic/npm-definitely-not-a-robot/issues"
    },
    "author": "Doug Silkstone <doug@withseismic.com> (https://withseismic.com)",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "playwright": "^1.64.1",
        "tsup": "^9.0.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    }
}
